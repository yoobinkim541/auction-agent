{
  "name": "gyeongmae-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "부동산 경매 매물 크롤링 + 권리분석/입지분석 Claude 에이전트 (개인 투자용)",
  "scripts": {
    "crawl": "tsx crawler/index.ts",
    "crawl:health": "tsx scripts/crawl-health.ts",
    "digest": "tsx scripts/daily-digest.ts",
    "snapshot": "tsx scripts/snapshot-predictions.ts",
    "collect:results": "tsx scripts/collect-results.ts",
    "watch:favs": "tsx scripts/watch-favorites.ts",
    "bid:prep": "tsx scripts/bid-prep.ts",
    "route": "tsx scripts/field-route.ts",
    "discover:courts": "tsx scripts/discover-courts.ts",
    "eval:report": "tsx scripts/eval-report.ts",
    "eval:calibrate": "tsx scripts/eval-report.ts",
    "eval:postmortem": "tsx scripts/eval-postmortem.ts",
    "registry-opinion:backfill": "tsx scripts/registry-opinion-backfill.ts",
    "backtest:sale-ratio": "tsx scripts/backtest-sale-ratio.ts",
    "ml:export": "tsx scripts/export-ml-dataset.ts",
    "ml:eval": "npm run ml:export && sh -c 'PY=python3; if [ -x .venv-ml/bin/python ]; then PY=.venv-ml/bin/python; fi; exec $PY scripts/ml/offline_eval.py --input artifacts/ml/outcome_eval.csv --output docs/phase2/ml-offline-report.md'",
    "ml:shadow": "tsx scripts/ml-shadow-ensemble.ts",
    "analyze": "tsx pipeline/run.ts",
    "ingest:legal": "tsx pipeline/legal/ingest.ts",
    "eval": "tsx pipeline/eval/run.ts",
    "bot": "tsx scripts/telegram-bot.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "enrich:poi": "tsx pipeline/location/enrich-poi.ts",
    "geocode:bulk": "tsx scripts/geocode-bulk.ts",
    "enrich:deonakchal": "tsx scripts/enrich-deonakchal.ts",
    "retry:outcomes": "tsx scripts/retry-outcome-results.ts",
    "trust:backfill": "tsx scripts/backfill-data-trust.ts",
    "precision:backfill": "tsx scripts/backfill-precision.ts",
    "precision:audit": "tsx scripts/precision-audit.ts",
    "photos:migrate-webp": "tsx scripts/migrate-listing-photos-webp.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "dotenv": "^17.4.2",
    "fetch-socks": "^1.3.3",
    "pg": "^8.21.0",
    "playwright": "^1.60.0",
    "sharp": "^0.35.4",
    "undici": "^8.5.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
