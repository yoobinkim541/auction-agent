# ── Claude (Anthropic) ──────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── DB (자체호스팅 PostgreSQL on Oracle Cloud VM) ───────────────
# Spring 백엔드와 TS 파이프라인이 같은 DB를 사용. 비밀번호는 setup 시 생성됨.
DATABASE_URL=postgres://gm_app:CHANGE_ME@127.0.0.1:5432/gyeongmae

# ── 더낙찰옥션 로그인 (본인 구독 계정) ──────────────────────────
# 개인 이용 전용. 절대 커밋 금지.
DEONAKCHAL_ID=
DEONAKCHAL_PW=

# ── 입지분석 외부 API ───────────────────────────────────────────
# 카카오 디벨로퍼스 REST API 키 (지오코딩 + 로컬 POI)
KAKAO_REST_KEY=
# 국토교통부 실거래가 OpenAPI (공공데이터포털 data.go.kr serviceKey, 디코딩 키)
MOLIT_SERVICE_KEY=
# 네이버 클라우드 지도 (지오코딩 폴백) — jipsuri-class와 동일 패턴
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# ── 법률 RAG ────────────────────────────────────────────────────
# 법제처 국가법령정보 OpenAPI OC(기관) 값
LAW_GO_KR_OC=
# VWorld(국토부) 지오코딩 — 무료 일 40,000건. vworld.kr 회원가입 → 오픈API → 인증키 발급(즉시).
# 설정 시 지오코딩 1순위로 사용(네이버 쿼터 보존). 미설정이면 네이버만.
VWORLD_KEY=
# 임베딩 (법령/판례 코퍼스용; PII 없음). 우선 OpenAI text-embedding-3-large
OPENAI_API_KEY=

# ── 텔레그램 알림 (경매 전용 봇) ────────────────────────────────
# scripts/notify-telegram.sh가 사용. 미설정이면 기존 .hermes(스톡봇) 스크립트로 폴백 발송됨.
# 경매 알림을 스톡봇과 분리하려면: @BotFather로 봇 생성 → 토큰, 대상 챗/채널 ID 입력.
# 양방향 봇(scripts/telegram-bot.ts, /case·/digest·/status)도 아래 AUCTION_* 를 우선 사용.
GM_TELEGRAM_BOT_TOKEN=
GM_TELEGRAM_CHAT_ID=
# 경매 봇 전용(권장). 설정 시 알림·양방향봇 모두 이 토큰/챗을 우선 사용.
AUCTION_BOT_TOKEN=
AUCTION_CHAT_ID=

# ── 다이제스트/대시보드 ────────────────────────────────────────
# 다이제스트 추천 상위 N건(기본 5)
# DIGEST_TOP_N=5
# 설정 시 다이제스트의 매물 링크를 대시보드 딥링크(<base>/#case=<사건번호>)로 — 미설정이면 courtauction 원본 링크.
# 예: https://web-yoobinkim541s-projects.vercel.app (Vercel 프로덕션, /api→VM 프록시)  또는  http://<서버IP>:5174
DASHBOARD_URL=

# ── 크롤러 동작 옵션 ────────────────────────────────────────────
# 요청 간 최소 지연(ms) — 폴라이트 크롤링
CRAWL_DELAY_MS=2500
# 헤드리스 여부 (최초 로그인 디버깅 시 false)
CRAWL_HEADLESS=true
# 전역 요청 간격 하한(ms) + 지터(ms) — 차단 회피 throttle. 회복 중엔 키워서 더 천천히.
# CRAWL_MIN_REQ_MS=2500
# CRAWL_REQ_JITTER_MS=1500

# ── 더낙찰 차단/계정플래그 서킷브레이커 ─────────────────────────
# 차단 감지 시 .auth/deonakchal-blocked.json 기록 후 이 시간(분)동안 로그인 시도 생략(영구정지 방지). 0=비활성.
# CRAWL_BLOCK_COOLDOWN_MIN=360
# 계정이 풀린 게 확실할 때 쿨다운 무시하고 재시도
# CRAWL_IGNORE_COOLDOWN=true
# 더낙찰 로그인은 데이터센터/미확인 egress를 항상 차단한다. 강제 우회 플래그는 지원하지 않는다.

# ── 분석 병렬도 (선택) ─────────────────────────────────────────
# 분석 파이프라인 동시 처리 수 (기본 6; MOLIT 쿼터 소진 주의)
# ANALYZE_CONCURRENCY=6
# 크롤러 매물별 동시 상세 요청 수 (기본 1; 절대 올리지 말 것 — 차단 원인)
# CRAWL_CONCURRENCY=1

# ── IP 차단 대비 프록시 설정 (선택) — 자세한 가이드: docs/crawl-proxy.md ──
# 더낙찰 보강 기본 프록시. 법원경매는 기본 직접망이며, 필요할 때 COURTAUCTION_PROXY로 별도 지정.
# 단일 SOCKS5 프록시 (CRAWL_PROXIES가 없을 때 사용)
#   집이 NAT 뒤면(권장): 집 PC에서  ssh -N -R 1080 ubuntu@<VM_공인_IP>  후 아래 설정
#   집에 공인 SSH 있으면:  VM에서  ssh -N -D 1080 user@<집_공인_IP>
# CRAWL_PROXY=socks5://127.0.0.1:1080
# 더낙찰 보강 로그인은 아래 등록 집 IP와 egress가 정확히 일치할 때만 진행
# CRAWL_HOME_IPS=<집_회선_공인_IP>
# 법원경매 전용 프록시(선택). CRAWL_PROXY를 공유하려면 COURTAUCTION_USE_CRAWL_PROXY=true
# COURTAUCTION_PROXY=socks5://127.0.0.1:1080
# COURTAUCTION_USE_CRAWL_PROXY=false
#
# 멀티프록시 순차 폴백 (쉼표 구분, CRAWL_PROXY보다 우선)
#   더낙찰 차단 감지 시 다음 프록시로 자동 전환. 전부 소진 시 법원경매 폴백.
#   예: 집 PC SSH터널(1080) + 라즈베리파이 SSH터널(1081)
# CRAWL_PROXIES=socks5://127.0.0.1:1080,socks5://127.0.0.1:1081
