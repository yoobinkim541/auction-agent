[Unit]
Description=Gyeongmae daily learning batch (outcome retry, AI opinions, postmortem, ML)
After=network.target postgresql.service gyeongmae-parse.service
Wants=postgresql.service
OnFailure=gyeongmae-alert@%n.service

[Service]
Type=oneshot
User=ubuntu
ExecStart=/home/ubuntu/projects/gyeongmae-agent/deploy/daily-learn.sh
# 결과 재수집(예산 100분) + claude CLI 45회(3s 간격·백오프) + ML 재학습(실측 약 13분).
TimeoutStartSec=10800
StandardOutput=append:/home/ubuntu/projects/gyeongmae-agent/learn.log
StandardError=append:/home/ubuntu/projects/gyeongmae-agent/learn.log
