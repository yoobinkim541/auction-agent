# ── Claude (Anthropic) ──────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── DB (자체호스팅 PostgreSQL on Oracle Cloud VM) ───────────────
# Spring 백엔드와 TS 파이프라인이 같은 DB를 사용. 비밀번호는 setup 시 생성됨.
DATABASE_URL=postgres://gm_app:CHANGE_ME@127.0.0.1:5432/gyeongmae

# ── 더낙찰옥션 로그인 (본인 구독 계정) ──────────────────────────
# 개인 이용 전용. 절대 커밋 금지.
DEONAKCHAL_ID=
DEONAKCHAL_PW=

# ── 입지분석 외부 API ───────────────────────────────────────────
# 카카오 디벨로퍼스 REST API 키 (지오코딩 + 로컬 POI)
KAKAO_REST_KEY=
# 국토교통부 실거래가 OpenAPI (공공데이터포털 data.go.kr serviceKey, 디코딩 키)
MOLIT_SERVICE_KEY=
# 네이버 클라우드 지도 (지오코딩 폴백) — jipsuri-class와 동일 패턴
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# ── 법률 RAG ────────────────────────────────────────────────────
# 법제처 국가법령정보 OpenAPI OC(기관) 값
LAW_GO_KR_OC=
# 임베딩 (법령/판례 코퍼스용; PII 없음). 우선 OpenAI text-embedding-3-large
OPENAI_API_KEY=

# ── 크롤러 동작 옵션 ────────────────────────────────────────────
# 요청 간 최소 지연(ms) — 폴라이트 크롤링
CRAWL_DELAY_MS=2500
# 헤드리스 여부 (최초 로그인 디버깅 시 false)
CRAWL_HEADLESS=true
